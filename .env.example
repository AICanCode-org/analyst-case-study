# Copy to .env (never commit .env). Everything works without any of these.
DASHBOARD_PORT=8501
EXPORT=2026-08
# Show another track's answers (after `docker compose --profile pipelines up`):
# ANSWERS_PATH=/answers/sql/answers.json
# Optional AI insight narrator (OpenAI-compatible API; a local Ollama needs no key):
AI_PROVIDER=offline
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=
LLM_TIMEOUT_MS=8000
